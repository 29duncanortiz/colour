import time
import board
import neopixel
 
pixel_pin = board.D2   #the ring data is connected to this pin
num_pixels = 16        #number of leds pixels on the ring
 
pixels = neopixel.NeoPixel(pixel_pin, num_pixels, brightness=0.3, auto_write=False)
 
RED = (255, 0, 0) #RGB
YELLOW = (255, 150, 0)
GREEN = (0, 255, 0)
CYAN = (0, 255, 255)
BLUE = (0, 0, 255)
PURPLE = (180, 0, 255)
WHITE = (255, 255, 255)
C1 = (209, 129, 324)
C2 = (12, 47, 234)
OFF = (0, 0, 0)

myCOLORS = [RED, YELLOW, GREEN, CYAN, BLUE, PURPLE, WHITE, C1, C2, OFF]

while True:  
    for color_index in range(0, len(myCOLORS), 1):
        pixels[0] = myCOLORS[color_index]
        pixels.show()
        time.sleep(1)
        
    for color_index in range(0, len(myCOLORS), 1):
        pixels[1] = myCOLORS[color_index]
        pixels.show()
        time.sleep(1)
