import board
import neopixel
 
pixel_pin = board.D2
num_pixels = 16
 
pixels = neopixel.NeoPixel(pixel_pin, num_pixels, brightness=0.7, auto_write=False)

while True:
    for red_fade_value in range(0, 254, 2):   #fade in loop
        COLOR = (red_fade_value, 0, 0)
        pixels[0] = COLOR
        pixels.show()

    for red_fade_value in range(254, 0, -2):   #fade out loop
        COLOR = ( red_fade_value, 0, 0)
        pixels[0] = COLOR
        pixels.show()
