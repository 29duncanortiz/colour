import time
import board
import neopixel
from digitalio import DigitalInOut, Direction, Pull
 
pixel_pin = board.D2
num_pixels = 16

switch = DigitalInOut(board.D3)
switch.direction = Direction.INPUT
switch.pull = Pull.UP
 
pixels = neopixel.NeoPixel(pixel_pin, num_pixels, brightness=0.0, auto_write=False)

BURNTORANGE = (221, 125, 51)
BRIGHTORANGE = (247, 125, 51)
PINKRED = (247, 56, 95)
RED = (234, 24, 26)
OFF = (0, 0, 0)

while True:
    print(switch.value)
    if switch.value == True:

        
        pixels[0] = BURNTORANGE
        pixels[1] = BRIGHTORANGE
        pixels[2] = PINKRED
        pixels[3] = RED
        pixels[4] = BURNTORANGE
        pixels[5] = BRIGHTORANGE
        pixels[6] = PINKRED
        pixels[7] = RED
        pixels[8] = BURNTORANGE
        pixels[9] = BRIGHTORANGE
        pixels[10] = PINKRED
        pixels[11] = RED
        pixels[12] = BURNTORANGE
        pixels[13] = BRIGHTORANGE
        pixels[14] = PINKRED
        pixels[15] = RED

        # fade in
        for b in range(0, 31):      # 0.0 to 0.30
            pixels.brightness = b / 100
            pixels.show()
            time.sleep(0.03)

        # fafe out
        for b in range(30, -1, -1):
            pixels.brightness = b / 100
            pixels.show()
            time.sleep(0.03)

    else:
        pixels.fill(OFF)
        pixels.show()
        time.sleep(0.1)
